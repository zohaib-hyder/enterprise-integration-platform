APP_ENV=development
APP_NAME=Northstar Integration Platform
# Set a PostgreSQL URL with the credentials you chose in the root .env.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/integration
CORS_ORIGINS=["http://localhost:3000"]

AUTH_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Set a randomly generated secret of at least 32 characters in production.
# CSRF_SECRET=your-randomly-generated-value
SESSION_HOURS=8
INVITATION_HOURS=48

# Required for webhook creation, rotation, simulation and ingress. Never reuse CSRF_SECRET.
# Run python3 scripts/setup_webhook_key.py from the root for private local configuration.
# WEBHOOK_ENCRYPTION_KEY=<canonical URL-safe base64 of 32 random bytes>

# Dedicated synthetic credential storage key, separate from the webhook key.
# From repository root: python3 scripts/setup_credential_key.py
# CREDENTIAL_ENCRYPTION_KEY=<canonical URL-safe base64 of 32 random bytes>
CREDENTIAL_KEY_REFERENCE=local-v1
# Optional previous references for decryption during operator-managed key changes.
# CREDENTIAL_PREVIOUS_KEYS={"previous-reference":"<private previous base64 key>"}
OPERATION_RETENTION_DAYS=7
OPERATION_RETENTION_MAX_ROWS=5000

# Phase 10: mock is always the default tenant provider. No key is needed.
AI_OPENAI_ENABLED=false
# AI_OPENAI_MODEL=YOUR_STRUCTURED_OUTPUT_CAPABLE_MODEL
# Supply AI_OPENAI_API_KEY privately only when explicitly enabling optional paid transport.
AI_TIMEOUT_SECONDS=8
AI_MAX_OUTPUT_TOKENS=1800
AI_MAX_CONCURRENCY=2
AI_REQUESTS_PER_HOUR=30
AI_RETENTION_DAYS=30
AI_MAX_RETAINED_REQUESTS=1000
# Optional USD pricing per million ACTUAL tokens, no built-in assumed price.
# AI_INPUT_PRICE_PER_MILLION=
# AI_OUTPUT_PRICE_PER_MILLION=
# Direct API host validation. Add explicit deployment hostnames; never use wildcards.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Per-process, bounded ingress protection; use an edge limit for multiple replicas.
WEBHOOK_REQUESTS_PER_MINUTE=120

# Production forbids debug and requires both independent encryption keys, persistent
# CSRF_SECRET, HTTPS AUTH_ORIGINS/CORS_ORIGINS and explicit ALLOWED_HOSTS.
APP_DEBUG=false
