# Copy into a private ignored file; replace all angle-bracket placeholders.
RELEASE_ENV_FILE=/absolute/path/to/repository/.local/production/release.env
POSTGRES_USER=platform
POSTGRES_PASSWORD=<random independent database password>
POSTGRES_DB=integration
DATABASE_URL=postgresql+psycopg://platform:<URL-encoded database password>@postgres:5432/integration
APP_ENV=production
APP_DEBUG=false
CSRF_SECRET=<random persistent secret of at least 32 characters>
WEBHOOK_ENCRYPTION_KEY=<URL-safe base64 of 32 random bytes>
CREDENTIAL_ENCRYPTION_KEY=<different URL-safe base64 of 32 random bytes>
ALLOWED_HOSTS=["api","127.0.0.1","workspace.example.test"]
AUTH_ORIGINS=["https://workspace.example.test"]
CORS_ORIGINS=[]
FRONTEND_ORIGINS=https://workspace.example.test
AI_OPENAI_ENABLED=false
RELEASE_PORT=3300
